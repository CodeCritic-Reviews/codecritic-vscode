{
  "name": "codecritic-vscode",
  "displayName": "CodeCritic - AI code review",
  "description": "AI code review for VS Code and Cursor - sidebar, scores, issues, Mark as done / Dismiss, Fix in Chat. Get an API key at code-critic.com.",
  "version": "0.1.17",
  "publisher": "CodeCritic",
  "license": "MIT",
  "homepage": "https://code-critic.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeCritic-Reviews/codecritic-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/CodeCritic-Reviews/codecritic-vscode/issues"
  },
  "keywords": [
    "codecritic",
    "code review",
    "ai",
    "cursor",
    "lint",
    "security",
    "quality"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "codecritic.setApiKey",
        "title": "CodeCritic: Set API key"
      },
      {
        "command": "codecritic.openDashboardApiKey",
        "title": "CodeCritic: Open Dashboard (API key)"
      },
      {
        "command": "codecritic.reviewSelection",
        "title": "CodeCritic: Review selection"
      },
      {
        "command": "codecritic.reviewActiveFile",
        "title": "CodeCritic: Review active file"
      },
      {
        "command": "codecritic.reviewFiles",
        "title": "CodeCritic: Review files…"
      },
      {
        "command": "codecritic.reviewFolder",
        "title": "CodeCritic: Review folder…"
      },
      {
        "command": "codecritic.openLastResult",
        "title": "CodeCritic: Open last review result"
      },
      {
        "command": "codecritic.focusHome",
        "title": "CodeCritic: Open sidebar"
      }
    ],
    "configuration": {
      "title": "CodeCritic",
      "properties": {
        "codecritic.apiBaseUrl": {
          "type": "string",
          "default": "https://api.code-critic.com",
          "description": "API base URL: production https://api.code-critic.com (extension calls …/v1/… on it). Local Rack: http://localhost:9292/api. Not the marketing site."
        },
        "codecritic.dashboardUrl": {
          "type": "string",
          "default": "https://code-critic.com",
          "description": "Dashboard URL for opening API key settings in the browser."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codecritic",
          "title": "CodeCritic",
          "icon": "media/icons/codecritic-activity.svg"
        }
      ]
    },
    "views": {
      "codecritic": [
        {
          "type": "webview",
          "id": "codecritic.home",
          "name": "CodeCritic"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "codecritic.reviewSelection",
          "group": "codecritic@1",
          "when": "editorHasSelection"
        },
        {
          "command": "codecritic.reviewActiveFile",
          "group": "codecritic@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0",
    "vitest": "^3.0.5"
  }
}
